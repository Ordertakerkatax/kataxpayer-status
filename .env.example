# Copy to .env.local for development. Server-only values must never be
# prefixed NEXT_PUBLIC_ and never imported from a client component.

NEXT_PUBLIC_SITE_URL=https://status.kataxpayer.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=               # server only
DEVICE_SALT=                        # long random string
IP_SALT=                            # long random string
CRON_SECRET=                        # long random string, also a GitHub secret
ADMIN_EMAIL=
BIR_USER_AGENT=KaTaxpayerStatusBot/1.0 (+https://status.kataxpayer.com/about)
